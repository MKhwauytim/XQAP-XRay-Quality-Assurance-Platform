# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
# The release build is the product: one self-contained file, committed so it can
# be downloaded and opened without a toolchain. Everything else Vite emits into
# dist/ stays ignored — dist/ is meant to hold exactly this one file. Note the
# `dist/*` rather than `dist`: git never descends into an excluded directory, so
# a bare `dist` would make the negation below unreachable.
dist/*
!dist/index.html
dist-ssr
*.local
.worktrees
dev-workspace

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

testsprite_tests\tmp\config.json

# Tool / analysis artifacts
lint-report.json
testsprite_tests/tmp/
.superpowers/
testsprite_tests/tmp/config.json

# Static executive-report preview (npm run report:static) — a regenerable
# artifact, never committed.
dist-preview/

# Netlify CLI/MCP local link state — records which remote site this working
# copy deploys to. Machine-local, not a project setting: committing it would
# point every clone at one person's preview site.
.netlify/

# Playwright (npm run e2e) — regenerable run artifacts, never committed.
# `test-results/` holds failure traces, screenshots and videos; `playwright-report/`
# is the generated HTML report. Both are uploaded as CI artifacts instead.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

 540V405L221 482.5Z" fill="#073257"/><path d="M320 405H480L401 479.5Z" fill="#03152b"/><path d="M480 405V540L401 479.5Z" fill="#020e1c"/><path d="M480 540H320L401 479.5Z" fill="#03152b"/><path d="M320 540V405L401 479.5Z" fill="#020e1c"/><path d="M480 405H640L559 469.5Z" fill="#062a48"/><path d="M640 405V540L559 469.5Z" fill="#062a48"/><path d="M640 540H480L559 469.5Z" fill="#062a48"/><path d="M480 540V405L559 469.5Z" fill="#062a48"/><path d="M640 405H800L733 466.5Z" fill="#062a48"/><path d="M800 405V540L733 466.5Z" fill="#062a48"/><path d="M800 540H640L733 466.5Z" fill="#062a48"/><path d="M640 540V405L733 466.5Z" fill="#062a48"/><path d="M800 405H960L894 490.5Z" fill="#062a48"/><path d="M960 405V540L894 490.5Z" fill="#0a3a5f"/><path d="M960 540H800L894 490.5Z" fill="#062a48"/><path d="M800 540V405L894 490.5Z" fill="#0a3a5f"/></svg></div>

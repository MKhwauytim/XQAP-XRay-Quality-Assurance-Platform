" fill="#f4b400" fill-opacity="0.22"/><rect x="84" y="97" width="26" height="26" rx="2" transform="rotate(77 97 110)" fill="#f4b400" fill-opacity="0.22"/><rect x="136" y="94" width="30" height="30" rx="2" transform="rotate(11 151 109)" fill="#f4b400" fill-opacity="0.22"/></svg></div>
  <svg class="v2-cover-band" viewBox="0 0 1200 400" preserveAspectRatio="none" aria-hidden="true">

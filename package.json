{
  "name": "x-ray-quality-app",
  "private": true,
  "version": "132.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "predev": "npm run generate:changelog",
    "dev": "vite",
    "prebuild": "npm run generate:changelog",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:ci": "eslint src e2e playwright.config.ts --max-warnings 0",
    "pretypecheck": "npm run generate:changelog",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "pretest": "npm run generate:changelog",
    "test": "vitest",
    "pretest:run": "npm run generate:changelog",
    "test:run": "vitest run",
    "generate:changelog": "node scripts/generate-changelog-data.mjs",
    "check:hex-literals": "node scripts/check-hex-literals.mjs",
    "check:complexity": "eslint src --max-warnings 0 --rule \"complexity: [error, 60]\" --rule \"max-lines-per-function: [error, 1450]\"",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:release": "node scripts/check-release-consistency.mjs",
    "check:vendor": "node scripts/check-vendor-integrity.mjs",
    "count-lines": "node scripts/count-lines.mjs",
    "editlog": "node scripts/editlog.mjs",
    "report:static": "node scripts/export-exec-report-static.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.10",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  }
}

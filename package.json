{
  "name": "x-ray-quality-app",
  "private": true,
  "version": "160.17.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "predev": "npm run generate:changelog",
    "dev": "vite",
    "prebuild": "npm run generate:changelog",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:ci": "eslint src --max-warnings 0",
    "pretypecheck": "npm run generate:changelog",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "pretest": "npm run generate:changelog",
    "test": "vitest",
    "pretest:run": "npm run generate:changelog",
    "test:run": "vitest run",
    "generate:changelog": "node scripts/generate-changelog-data.mjs",
    "check:hex-literals": "node scripts/check-hex-literals.mjs",
    "check:complexity": "eslint src --max-warnings 0 --rule \"complexity: [error, 60]\" --rule \"max-lines-per-function: [error, 1450]\"",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:release": "node scripts/check-release-consistency.mjs",
    "check:vendor": "node scripts/check-vendor-integrity.mjs",
    "count-lines": "node scripts/count-lines.mjs",
    "editlog": "node scripts/editlog.mjs",
    "report:static": "node scripts/export-exec-report-static.mjs",
    "build:port-tool": "vite build --config vite.port-tool.config.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-virtual": "3.14.11",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "hash-wasm": "^4.12.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.68.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}

{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "x-ray-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "x-ray-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview"
      ],
      "port": 4173
    },
    {
      "name": "exec-report-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--config",
        "vite.static-preview.config.ts",
        "--port",
        "5179",
        "--strictPort"
      ],
      "port": 5179
    }
  ]
}
